# TalentFlow ATS - Environment Configuration

# Flask Secret Key
SECRET_KEY=talentflow-recruiter-ats-key-2026

# Server Port (default 5000)
PORT=5000

# Database Connection (Default: local SQLite database)
# SQLite:
DATABASE_URL=sqlite:///talentflow.db

# PostgreSQL (e.g. Supabase, Neon, AWS RDS, Render, Local Postgres):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/talentflow_db

# MySQL:
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/talentflow_db
